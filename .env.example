# Admin CMS password (required). The CMS login checks against this value.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (required in production).
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-insecure-secret-change-me

# Where the SQLite database file and uploaded covers live.
# Defaults to ./data when unset.
DATA_DIR=./data

# Port for the production server (node build). Dev server uses Vite's own port.
PORT=3000
# Max upload/body size for adapter-node (cover uploads). Default in this app: 8M.
BODY_SIZE_LIMIT=8M

# Behind a reverse proxy, uncomment so the real client IP reaches analytics + brute-force guard.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1   # number of trusted proxies in front of the app

# IPs whose views/downloads are NOT counted in analytics (e.g. your own IP).
# Comma or space separated. Logged-in admin is always excluded automatically.
# ANALYTICS_EXCLUDE_IPS=203.0.113.10 198.51.100.2
# Trust the X-Forwarded-* headers from a reverse proxy (Caddy/Nginx). Set to true behind a proxy.
# ORIGIN is required by adapter-node behind a proxy for CSRF/redirects, e.g. https://comics.example.com
# ORIGIN=https://comics.example.com
